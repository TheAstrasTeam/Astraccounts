# Gin runtime mode: debug, release, or test
GIN_MODE=debug

# Comma-separated IP addresses or CIDR ranges trusted for X-Forwarded-For.
GIN_TRUSTED_PROXIES=127.0.0.1,::1

# Seconds a login token stays valid after it was issued.
TOKEN_VALID_SECS=3600

# HMAC secret used to sign login tokens. Use a long random value.
# When empty a random secret is generated at startup, which invalidates
# every previously issued token on each restart.
TOKEN_SECRET=

# Profile keys a client may write through /api/profile/edit.
# Format: name:type[:visibility]
#   type       string | number | bool
#   visibility public (default) | private
# Private keys are only returned by /api/profile/view when the request carries
# a valid token for that user.
#
# The keys "username" and "register" are built in: the server fills them in at
# registration time and they exist regardless of this setting. Declaring either
# one here is a configuration error. "username" is an editable string,
# "register" is a read-only number that /api/profile/edit always rejects.
ALLOWED_PROFILE_KEY=bio:string,secret:string:private

# ──────────────────────────────────────────────────────────────────────────────
# Mail server (optional). Set MAIL_DOMAIN to enable the built-in SMTP, POP3 and
# IMAP services. Every registered user automatically owns a mailbox at
# <user-id>@MAIL_DOMAIN.
#
# All mail listeners default to standard ports. Set a value explicitly to
# change the port, or set to "off" to disable that listener. The implicit TLS
# ports (465/995/993) are skipped when no TLS certificate is configured.
#
# Mail is opt-in: with no MAIL_DOMAIN the service runs exactly as before.
# ──────────────────────────────────────────────────────────────────────────────

# The domain this mail server owns. Required to enable the mail server.
MAIL_DOMAIN=example.test

# The hostname advertised in SMTP banners and Received headers. Defaults to
# MAIL_DOMAIN if omitted.
MAIL_HOSTNAME=mx.example.test

# Additional domains served by this instance (comma-separated). Mail addressed
# to these domains is treated as local.
MAIL_EXTRA_DOMAINS=

# Listener addresses. Defaults are the standard ports. Set to "off" to disable.
MAIL_SMTP_ADDR=:25           # MX delivery from the internet
MAIL_SUBMISSION_ADDR=:587    # Authenticated clients send mail here (STARTTLS)
MAIL_SUBMISSION_TLS_ADDR=:465 # Authenticated clients send mail here (implicit TLS)
MAIL_POP3_ADDR=:110          # POP3 (plaintext + STLS)
MAIL_POP3_TLS_ADDR=:995      # POP3 over TLS
MAIL_IMAP_ADDR=:143          # IMAP (plaintext + STARTTLS)
MAIL_IMAP_TLS_ADDR=:993      # IMAP over TLS

# TLS certificate shared by all mail listeners. When set, STLS is offered on
# the plaintext ports and the implicit-TLS ports become usable. Both must be
# set together.
MAIL_TLS_CERT_FILE=
MAIL_TLS_KEY_FILE=

# Maximum message size in bytes. Default is 25 MB.
MAIL_MAX_MESSAGE_BYTES=26214400

# Allow relaying to domains this server does not own. When disabled, the
# submission port only accepts local recipients.
MAIL_RELAY=true

# Smarthost for outbound delivery. Use this when outbound port 25 is blocked
# (most cloud providers). If set, all outbound mail goes through this host
# instead of direct MX delivery. Credentials are optional; when provided they
# are sent via SMTP AUTH (PLAIN) over STARTTLS.
MAIL_SMARTHOST_ADDR=
MAIL_SMARTHOST_USER=
MAIL_SMARTHOST_PASSWORD=

# DKIM signing for outgoing mail. Both must be set together. The domain may
# differ from MAIL_DOMAIN; when omitted MAIL_DOMAIN is used. The key file must
# be PEM-encoded PKCS#1 or PKCS#8 (RSA or Ed25519).
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_KEY_FILE=